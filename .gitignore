node_modules/

.env
.env.*
!.env.example

dist/
*.tsbuildinfo
coverage/

# backend embeds the built frontend from this dir at compile time; keep
# the placeholder index.html tracked so a fresh clone still builds, but
# not the real build output (regenerated by `make build-frontend`).
!backend/internal/web/dist/
backend/internal/web/dist/*
!backend/internal/web/dist/index.html

.DS_Store
*.log
